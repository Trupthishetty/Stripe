<form id="payment-form" data-item="{{itemId}}" data-publishable-key="{{publishableKey}}">
  <div>
    <label for="email">Email address</label>
    <input type="email" class="form-control" id="email" name="email" required>
  </div>
  <div id="payment-element" class="mt-20"></div>
  <div id="payment-message" class="mt-20 text-danger d-none"></div>
  <div class="mt-20">
    <button id="submit" type="submit" class="btn btn-lg btn-block btn-primary">
      <span id="button-text">Pay $<span class="amount" data-amount="{{amount}}"></span></span>
      <span id="spinner" class="d-none">Processing…</span>
    </button>
  </div>
</form>
<script src="/js/checkout.js"></script>